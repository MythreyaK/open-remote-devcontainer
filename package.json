{
  "name": "open-remote-devcontainer",
  "displayName": "Open Remote - Devcontainer",
  "description": "Build & run a devcontainer using Docker or Podman",
  "publisher": "mythreyak",
  "version": "0.7.0",
  "license": "AGPL-3.0-only",
  "homepage": "https://github.com/mythreyak/open-remote-devcontainer#readme",
  "repository": {
    "type": "git",
    "url": "https://github.com/mythreyak/open-remote-devcontainer.git"
  },
  "bugs": {
    "url": "https://github.com/mythreyak/open-remote-devcontainer/issues"
  },
  "engines": {
    "vscode": "^1.110.0"
  },
  "categories": [
    "Other"
  ],
  "keywords": [
    "docker",
    "podman",
    "remote",
    "container",
    "containers",
    "devcontainer",
    "devcontainers",
    "dev container",
    "dev containers"
  ],
  "main": "./dist/extension.js",
  "activationEvents": [
    "workspaceContains:.devcontainer/devcontainer.json",
    "workspaceContains:.devcontainer.json",
    "onResolveRemoteAuthority:devcontainer-remote"
  ],
  "contributes": {
    "commands": [
      {
        "command": "open-remote-devcontainer.getVersion",
        "category": "Remote - Devcontainer",
        "title": "Get engine version"
      },
      {
        "command": "open-remote-devcontainer.openRemote",
        "category": "Remote - Devcontainer",
        "title": "Open workspace in container"
      },
      {
        "command": "open-remote-devcontainer.rebuildOpenRemote",
        "category": "Remote - Devcontainer",
        "title": "Rebuild and reopen in container"
      },
      {
        "command": "open-remote-devcontainer.rebuildNoCacheOpenRemote",
        "category": "Remote - Devcontainer",
        "title": "Rebuild without cache and reopen in container"
      },
      {
        "command": "open-remote-devcontainer.openLocal",
        "category": "Remote - Devcontainer",
        "title": "Reopen workspace locally"
      },
      {
        "command": "open-remote-devcontainer.openLocal",
        "category": "Remote - Devcontainer",
        "title": "Close remote (reopen locally)"
      },
      {
        "command": "open-remote-devcontainer.showDevcontainerFile",
        "category": "Remote - Devcontainer",
        "title": "Show configuration (devcontainer.json)"
      },
      {
        "command": "open-remote-devcontainer.showLog",
        "category": "Remote - Devcontainer",
        "title": "Show log file"
      }
    ],
    "configuration": {
      "title": "Remote - Devcontainer",
      "properties": {
        "remote.devcontainer.engine": {
          "type": "string",
          "default": "docker",
          "description": "Path to the container executable engine. E.g., 'docker', 'podman'. Default: docker"
        },
        "remote.devcontainer.extraArgs": {
          "type": "array",
          "default": [],
          "description": "Extra runtime parameters to pass to the executable. E.g., ['--root', '/custom/storage']"
        }
      }
    }
  },
  "capabilities": {
    "untrustedWorkspaces": {
      "supported": "limited",
      "description": "Devcontainer requires executing docker/podman commands on the host"
    }
  },
  "enabledApiProposals": [
    "resolvers",
    "contribViewsRemote",
    "taskPresentationGroup"
  ],
  "extensionKind": [
    "ui"
  ],
  "scripts": {
    "compile": "tsc --noEmit && eslint src",
    "build": "npm run build:dev",
    "build:dev": "node esbuild.js && cp src/remote/installServer.sh dist/ && cp src/engine/Dockerfile dist/",
    "build:clean": "rm -rf dist out",
    "build:prod": "node esbuild.js --production && cp src/remote/installServer.sh dist/ && cp src/engine/Dockerfile dist/",
    "test": "npm run test:noengine",
    "test:noengine": "SKIP_ENGINE_TESTS=1 vitest run",
    "test:engine": "vitest run",
    "verify": "npm run compile && npm run test:noengine",
    "verify:all": "npm run compile && npm run test:engine",
    "watch": "npm-run-all -p watch:*",
    "watch:esbuild": "node esbuild.js --watch",
    "watch:tsc": "tsc --noEmit --watch --project tsconfig.json",
    "package": "npm run verify && npm run build:prod && npm run vsce",
    "package:all": "npm run verify:all && npm run build:prod && npm run vsce",
    "package:clean": "npm run build:clean && npm run package",
    "vsce": "vsce package",
    "dts": "cd src/remote/typings && dts dev"
  },
  "dependencies": {
    "jsonc-parser": "^3.3.1",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@stylistic/eslint-plugin": "^5.10.0",
    "@types/node": "^22.20.0",
    "@types/vscode": "^1.110.0",
    "@vitest/coverage-v8": "^4.1.10",
    "@vscode/dts": "^0.4.1",
    "@vscode/vsce": "^3.9.2",
    "esbuild": "^0.28.1",
    "eslint": "^9.39.3",
    "jest-mock-vscode": "^4.12.0",
    "npm-run-all": "^4.1.5",
    "ovsx": "^1.0.2",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.56.1",
    "vitest": "^4.1.8"
  }
}
