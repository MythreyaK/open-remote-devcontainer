{
  "name": "open-remote-devcontainer",
  "displayName": "Open Remote - Devcontainer",
  "description": "Build & run a devcontainer using Docker or Podman",
  "publisher": "mythreyak",
  "version": "0.7.0",
  "license": "UNDECIDED",
  "homepage": "https://github.com/mythreyak/open-remote-devcontainer#readme",
  "repository": {
    "type": "git",
    "url": "https://github.com/mythreyak/open-remote-devcontainer.git"
  },
  "bugs": {
    "url": "https://github.com/mythreyak/open-remote-devcontainer/issues"
  },
  "engines": {
    "vscode": "^1.110.0"
  },
  "categories": [
    "Other"
  ],
  "keywords": [
    "container",
    "devcontainer",
    "remote",
    "docker",
    "podman"
  ],
  "main": "./dist/extension.js",
  "activationEvents": [
    "workspaceContains:.devcontainer/devcontainer.json",
    "workspaceContains:.devcontainer.json"
  ],
  "contributes": {
    "commands": [
      {
        "command": "open-remote-devcontainer.helloWorld",
        "title": "Hello World"
      },
      {
        "command": "open-remote-devcontainer.getVersion",
        "title": "getVersion"
      }
    ],
    "configuration": {
      "title": "Remote - Devcontainer",
      "properties": {
        "remote.devcontainer.engine": {
          "type": "string",
          "default": "docker",
          "description": "Path to the container executable engine. E.g., 'docker', 'podman'. Default: docker"
        },
        "remote.devcontainer.extraArgs": {
          "type": "array",
          "default": [],
          "description": "Extra runtime parameters to pass to the executable. E.g., ['--root', '/custom/storage']"
        }
      }
    }
  },
  "capabilities": {
    "untrustedWorkspaces": {
      "supported": "limited",
      "description": "Devcontainer requires executing docker/podman commands on the host"
    }
  },
  "enabledApiProposals": [
    "resolvers",
    "contribViewsRemote"
  ],
  "extensionKind": [
    "ui"
  ],
  "scripts": {
    "vscode:prepublish": "npm run package",
    "compile": "npm run check-types && npm run lint && node esbuild.js",
    "package": "npm run check-types && npm run lint && node esbuild.js --production",
    "watch": "npm-run-all -p watch:*",
    "watch:esbuild": "node esbuild.js --watch",
    "watch:tsc": "tsc --noEmit --watch --project tsconfig.json",
    "watch-tests": "tsc -p . -w --outDir out",
    "compile-tests": "tsc -p . --outDir out",
    "pretest": "npm run compile-tests && npm run compile && npm run lint",
    "check-types": "tsc --noEmit",
    "dts": "cd src/remote/typings && npx @vscode/dts dev",
    "lint": "eslint src",
    "test": "vitest run"
  },
  "dependencies": {
    "jsonc-parser": "^3.3.1",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/node": "22.x",
    "@types/vscode": "^1.110.0",
    "@vscode/dts": "^0.4.1",
    "@vscode/vsce": "^3.9.2",
    "esbuild": "^0.28.1",
    "eslint": "^9.39.3",
    "jest-mock-vscode": "^4.12.0",
    "npm-run-all": "^4.1.5",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.56.1",
    "vitest": "^4.1.8"
  }
}
